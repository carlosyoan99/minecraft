{
	"name": "mi-minecraft",
	"version": "1.0.0",
	"description": "Clon de Minecraft con servidor Node.js autoritativo (chunks, biomas, IA de mobs, crafteo, horno, persistencia)",
	"keywords": [
		"minecraft",
		"clon",
		"voxel",
		"three.js",
		"websocket",
		"nodejs",
		"juego"
	],
	"license": "MIT",
	"author": "Carlos Yoan",
	"repository": {
		"type": "git",
		"url": "https://github.com/carlosyoan99/minecraft"
	},
	"engines": {
		"node": ">=18"
	},
	"main": "server/server.js",
	"type": "commonjs",
	"scripts": {
		"start": "node server.js",
		"test": "node tests/run.js",
		"test:coverage": "c8 --all --src=server --src=public --reporter=text --check-coverage=50 --thresholds=\"server/*.js:80:80:80:75\" --thresholds=\"public/*.js:15:50:15:50\" node tests/run.js --unit",
		"audit": "npm audit --audit-level=moderate",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"graph": "madge --circular server/ public/",
		"deadcode": "knip"
	},
	"dependencies": {
		"express": "^4.19.2",
		"simplex-noise": "^4.0.1",
		"uuid": "^14.0.2",
		"ws": "^8.17.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.6",
		"c8": "^12.0.0",
		"knip": "^6.32.2",
		"madge": "^8.0.0",
		"three": "^0.160.0"
	}
}
