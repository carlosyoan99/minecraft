# ============================================================
# .gitignore del proyecto (clon de Minecraft)
# Convención: node_modules/ y world/ (datos de mundo generados)
# nunca se versionan; tampoco los temporales de auditoría (tmp-*),
# ver CONTRIBUTING.md §Commits.
# ============================================================

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- Logs de ejecución de tests (Fase 15: captura por test para no re-ejecutar) ---
tests/last-run/

# --- Datos de mundo generados (por semilla, se regeneran) ---
world/

# --- Temporales de auditoría y diagnóstico ---
tmp-*
*.tmp.js
/tmp/

# --- Cobertura de tests (G1.2: c8, se regenera con npm run test:coverage) ---
coverage/

# --- Entorno de agentes (skills de tooling, no parte del juego) ---
.agents/
skills-lock.json

# --- Sistema operativo ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Editores / IDEs ---
.vscode/
.idea/
*.code-workspace
.opencode

# --- Secretos y configuración local ---
.env
.env.*
!.env.example
